# AI Designer production environment — copy to /etc/ai-designer.env on the server,
# fill in real values, then: sudo chmod 600 /etc/ai-designer.env
# (values with spaces need no quotes in systemd EnvironmentFile format)

# -- required --
APP_ENV=production
PORT=8080
API_KEY=
API_BASE=https://image-provider.example/v1
IMAGE_API_PROVIDER=openai
MODEL=gpt-image-2.5-sunburst
IMAGE_RESOLUTION=
IMAGE_SIZE_ENABLED=0

# -- accounts mode (email signup + credits, Neon Postgres) --
# Setting DATABASE_URL switches the app to per-user accounts; leave empty to
# use the shared APP_USERNAME/APP_PASSWORD gate instead.
DATABASE_URL=
GENERATION_COST=1
REGISTRATION_ENABLED=0
FREE_SIGNUP_CREDITS=0
SESSION_SECRET=
# Optional but strongly recommended before public signup.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REGISTER_RATE_LIMIT=3
REGISTER_RATE_WINDOW_SECONDS=86400
LOGIN_IP_RATE_LIMIT=30
LOGIN_ACCOUNT_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=3600

# -- shared-password mode (only if DATABASE_URL is empty) --
APP_USERNAME=
APP_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# -- style reference sources --
PEXELS_API_KEY=
PINTEREST_SCRAPE=0

# -- optional --
# Empty rewrite key/base reuse API_KEY/API_BASE above.
REWRITE_API_KEY=
REWRITE_API_BASE=
REWRITE_MODEL=gpt-5.6-luna-official
REWRITE_ENABLED=1
PUBLIC_BASE_URL=https://example.com

# systemd unit for the AI Designer app server.
# Install: sudo cp secpic.service /etc/systemd/system/ai-designer.service && sudo systemctl daemon-reload
# Env lives in /etc/ai-designer.env (copy deploy/secpic.env.example there and fill it).

[Unit]
Description=AI Designer FastAPI server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-designer
WorkingDirectory=/opt/ai-designer/app
EnvironmentFile=/etc/ai-designer.env
# Keep the application private behind Caddy/nginx. server.py itself binds 0.0.0.0.
# The app validates forwarded client IPs; preserve the actual proxy peer here.
ExecStart=/opt/ai-designer/venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port ${PORT} --no-proxy-headers
Restart=always
RestartSec=3
# The app writes aid.db + reference_uploads/ inside WorkingDirectory.
ReadWritePaths=/opt/ai-designer/app

[Install]
WantedBy=multi-user.target

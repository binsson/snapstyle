# AI Designer 环境变量示例
# 复制为 .env 后填入真实值（.env 已在 .gitignore，不会被 commit）

# ===== 图像生成（必填）=====
# 填入自己的兼容 API 服务地址和密钥；.example 地址仅用于演示。
API_KEY=
API_BASE=https://image-provider.example/v1
IMAGE_API_PROVIDER=openai
MODEL=gpt-image-2.5-sunburst
IMAGE_SIZE_ENABLED=0
IMAGE_RESOLUTION=
# 摄影短提示 / 风格分析可单独配置；留空时共用图片服务配置。
REWRITE_API_KEY=
REWRITE_API_BASE=
REWRITE_MODEL=gpt-5.6-luna-official
# 没有兼容视觉模型时设置 0，已有图库使用本地拍摄提示词。
REWRITE_ENABLED=1

# ===== 在线图库（可选）=====
# Pexels 官方 API：填写使用者自己的密钥后启用。
PEXELS_API_KEY=
# Pinterest 默认关闭；仅在取得所需授权后安装 requirements-pinterest.txt 并显式开启。
PINTEREST_SCRAPE=0
# 浏览器登录态仅在本地配置，不应导出或提交 Cookie。
# PINTEREST_COOKIES_BROWSER=

# ===== 账户 + 积分模式（设了 DATABASE_URL 即开启）=====
# Neon Postgres 连接串。设置后：邮箱注册登录 + 按积分计费。
# 不设置：保持旧的「共享账号 + 按 IP 每天限流」行为。
# 形如 postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# 公开注册默认关闭；支付上线后设为 1 再开放
REGISTRATION_ENABLED=0
# 新用户初始额度；默认不赠送免费试用
FREE_SIGNUP_CREDITS=0
# 每生成一张消耗的积分
GENERATION_COST=1
# 是否强制邮箱验证后才能生成（1 开启）。开启前需配置邮件发送（后续步骤）
REQUIRE_EMAIL_VERIFICATION=0
# 注册防刷（推荐）：在 Cloudflare Turnstile 创建站点后成对填写。
# 只填一个会拒绝启动，避免误以为验证已生效。
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# 持久化登录/注册限流（账户模式下存入 Neon，重启不会清空）
# REGISTER_RATE_LIMIT=3
# REGISTER_RATE_WINDOW_SECONDS=86400
# LOGIN_IP_RATE_LIMIT=30
# LOGIN_ACCOUNT_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SECONDS=3600

# ===== 管理员账号（可选，账户模式下仍可用，额度无限、绕过扣费）=====
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== 旧版共享账号（可选；设了 DATABASE_URL 后一般不再需要）=====
# APP_USERNAME=
# APP_PASSWORD=

# ===== 其它（可选）=====
# 签名 token 的密钥；生产账户模式必填，改动会让所有人重新登录
# SESSION_SECRET=
# 旧版按 IP 的每日生成上限（仅在未启用账户模式时生效）
# DAILY_GENERATION_LIMIT=20

# 自己的网站地址；留空则从请求推导。
PUBLIC_BASE_URL=

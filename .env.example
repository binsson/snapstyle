# SnapStyle 环境变量模板
# SnapStyle environment template
# 复制为 .env 后填写自己的配置，真实 .env 文件不会提交到 Git。
# Copy to .env and fill in your own values. Real .env files are ignored by Git.

# ===== 图片生成（必填）=====
# ===== Image generation (required) =====
# 填写自己的兼容服务地址与密钥，.example 地址仅为占位符。
# Use your own compatible endpoint and key. The .example URL is a placeholder.
API_KEY=
API_BASE=https://image-provider.example/v1
IMAGE_API_PROVIDER=openai
MODEL=gpt-image-2.5-sunburst
IMAGE_SIZE_ENABLED=0
IMAGE_RESOLUTION=
# 摄影指导与风格分析可以使用独立服务。
# Photography guidance and style analysis may use a separate service.
# 留空时共用图片服务配置。
# Empty values fall back to the image service configuration.
REWRITE_API_KEY=
REWRITE_API_BASE=
REWRITE_MODEL=gpt-5.6-luna-official
# 没有兼容视觉服务时设为 0，已有风格使用本地描述。
# Set to 0 without a compatible vision service; existing styles use local briefs.
REWRITE_ENABLED=1

# ===== 在线图源（可选）=====
# ===== Online image sources (optional) =====
# Pexels 官方 API：填写自己的密钥后启用。
# Pexels official API: enabled when you supply your own key.
PEXELS_API_KEY=
# Pinterest 默认关闭，仅在取得所需授权后开启，
# Pinterest is off by default. Enable only with the required authorization,
# 并先安装 requirements-pinterest.txt。
# and after installing requirements-pinterest.txt.
PINTEREST_SCRAPE=0
# 浏览器登录态仅在本地配置，不要导出或提交 Cookie。
# Configure browser sessions locally. Never export or commit cookies.
# PINTEREST_COOKIES_BROWSER=

# ===== 邮箱账户与积分（设置 DATABASE_URL 后启用）=====
# ===== Email accounts and credits (enabled by DATABASE_URL) =====
# Postgres 连接串，启用邮箱登录与独立用户积分。
# Postgres connection string. Enables email login and per-user credits.
# 未设置时使用共享账号与按 IP 的每日限额。
# Without it, the app uses shared credentials and daily IP-based quotas.
# Example: postgresql://user:password@database.example/dbname?sslmode=require
DATABASE_URL=
# 公开注册默认关闭，需要显式开启。
# Public registration is off until explicitly enabled.
REGISTRATION_ENABLED=0
# 新账号初始积分，默认不赠送试用积分。
# Initial credit allowance; no free trial credits by default.
FREE_SIGNUP_CREDITS=0
# 每张生成图片消耗的积分。
# Credits charged for each generated image.
GENERATION_COST=1
# 生成前要求验证邮箱，开启前先配置邮件发送。
# Require verified email before generation. Configure email delivery first.
REQUIRE_EMAIL_VERIFICATION=0
# 可选的 Cloudflare Turnstile 验证，两个密钥应成对设置。
# Optional Cloudflare Turnstile verification. Set both keys together.
# 只配置一个密钥会拒绝启动。
# Startup fails if only one key is provided.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# 持久化认证限流，账户模式保存在 Postgres。
# Persistent authentication throttles; stored in Postgres in account mode.
# REGISTER_RATE_LIMIT=3
# REGISTER_RATE_WINDOW_SECONDS=86400
# LOGIN_IP_RATE_LIMIT=30
# LOGIN_ACCOUNT_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SECONDS=3600

# ===== 管理员（可选，账户模式同样可用）=====
# ===== Administrator (optional; also available in account mode) =====
# 管理员绕过积分扣费与 IP 限额。
# Administrators bypass credit charges and IP quotas.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== 共享账号（可选，账户模式通常不需要）=====
# ===== Shared account (optional; generally unused with DATABASE_URL) =====
# APP_USERNAME=
# APP_PASSWORD=

# ===== 其他设置（可选）=====
# ===== Other settings (optional) =====
# 令牌签名密钥，生产账户模式必填。
# Token signing secret; required for production account mode.
# 修改后已有登录会失效。
# Changing it invalidates existing sessions.
# SESSION_SECRET=
# 未启用邮箱账号时的每日 IP 限额。
# Daily IP quota for legacy mode without email accounts.
# DAILY_GENERATION_LIMIT=20

# 网站公开地址，留空时从请求推导。
# Public site URL; inferred from the request when empty.
PUBLIC_BASE_URL=
